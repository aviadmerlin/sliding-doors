# Azure AI Speech credentials, used by scripts/generate-voiceover.ts.
# Get these from the sliding-doors-resource Cognitive Services account
# (az cognitiveservices account keys list -n sliding-doors-resource -g <rg>),
# or from a Speech resource of your own in an allowed region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=switzerlandnorth

# Live app URL used by scripts/record-footage.ts.
APP_URL=https://sliding-doors.happytree-e6502234.switzerlandnorth.azurecontainerapps.io/
