# Microsoft Foundry / Azure OpenAI deployment (used by src/agent.py via
# Microsoft Agent Framework's AzureOpenAIChatClient, which reads these exact
# variable names automatically -- no extra wiring needed).
#
# AZURE_OPENAI_ENDPOINT: the Foundry project's Azure OpenAI endpoint, e.g.
#   https://<your-resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY: the Foundry project's API key.
# AZURE_OPENAI_CHAT_DEPLOYMENT_NAME: the deployment name you gave the
#   gpt-5-mini (Global Standard) deployment in the Foundry project.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=

# Optional: enables tracing of agent runs + tool calls to Application
# Insights (visible in the Foundry portal's tracing view). Leave empty to
# run with no tracing -- tests never require this to be set. Found under
# the Foundry project's "Application Insights" / "Tracing" settings.
APPLICATIONINSIGHTS_CONNECTION_STRING=
